{
  "hosting": {
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/build-env.mjs\""
    ],
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          }
        ]
      },
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/privacy",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(webp|jpg|jpeg|png|ico|otf|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(xml|txt|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      ".firebase/**",
      ".idea/**",
      ".vscode/**",
      ".git/**",
      "**/node_modules/**",
      "note.txt",
      "content.docx",
      "mockup/**",
      "_archive/**",
      "google-apps-script/**",
      "scripts/**",
      "assets/element/**",
      "assets/img/team-cutout.webp",
      "assets/fonts/AvenirLTProLight.otf",
      "assets/fonts/IBMPlexSansThai-*.ttf",
      "assets/fonts/MyriadPro-Regular.otf",
      "assets/fonts/PSL156pro.ttf",
      "assets/fonts/psl162sp.ttf",
      "assets/fonts/PSL Kanda Pro*",
      "assets/fonts/THSarabun.ttf",
      "**/*.php",
      "data/**",
      "**/*.zip",
      "**/*.log"
    ]
  }
}
